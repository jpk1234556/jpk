PORT=8000
DB_HOST=your_database_host  # e.g., localhost or your Supabase DB host
DB_PORT=5432
DB_NAME=your_database_name  # e.g., property_management
DB_USER=your_database_user  # e.g., postgres or your Supabase DB user
DB_PASSWORD=your_database_password  # Your actual database password
SUPABASE_URL=your_supabase_project_url  # Your Supabase project URL
SUPABASE_KEY=your_supabase_anon_key  # Your Supabase anon key